<script src="/js/jquery-3.5.1.min.js"></script>

   <script type="text/javascript">
   function getCookieValue(a) {
    var b = document.cookie.match('(^|;)\\s*' + a + '\\s*=\\s*([^;]+)');
    return b ? b.pop() : '';
}
   function delayer(){
   var lang = getCookieValue("lang");
   window.location ="/"+lang;
   }
   
   
$(document).ready(function(){
	if (getCookieValue("lang") == "tc"){
		document.title = '404 - 政府統計處';
		$('.site_logo').html('<a href="/tc/"><img class="logo" src="/img/tc/logo.svg" alt="政府統計處">&nbsp;</a>');
		$('.site_logo_small').html('<a href="/tc/"><img class="logo" src="/img/tc/logo_s.svg" alt="政府統計處">&nbsp;</a>');
    }else if(getCookieValue("lang") == "sc"){
		document.title = '404 - 政府统计处';
		$('.site_logo').html('<a href="/sc/"><img class="logo\" src="/img/sc/logo.svg" alt="政府统计处">&nbsp;</a>');
		$('.site_logo_small').html('<a href="/sc/"><img class="logo" src="/img/sc/logo_s.svg" alt="政府统计处">&nbsp;</a>');
	}
	window.onload = function() {
            setTimeout(delayer, 5000); 
        };
});
   </script>
<body data-spy="scroll" data-target=".navbar" data-offset="50">
	<script src="/js/jquery-3.5.1.min.js"></script>

