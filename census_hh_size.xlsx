	    <script>
    window.addEventListener('load', () => {
        const button = document.querySelector('#clear');
        button.addEventListener('click', () => {
           // document.querySelector('#dp-category-MHE3').value = "";
           //resetMap("dp_resetMapButton-MHE1");
		   ClearMHE();
        });
    });
    
    var reloadSelectDCTimer = setInterval(function() {
        var tab = $("#Characteristicstabs").find(".tab_selected").index();
        //console.log(tab);
        if(tab === 0){
            if($("#TablePanel1").text().trim() === ""){
                console.log("reloading method selectDC");
                selectDC('dp-category-DCD1');
            }else{
                console.log("reloaded method selectDC");
                clearInterval(reloadSelectDCTimer);
            }
        }else{
            console.log("default to tab 1.");
            $("#Characteristicstabbox1").click();
        }
		$('li[tabindex="-1"]').each(function() {
			$(this).attr('tabindex', '0');
			});
    }, 2500);

var interval = 400;
var timer = window.setInterval(function(){
    var empt = document.getElementById("dp-category-MHE3").value;
	if(empt == ""){
	 $('#clear').css('display', 'none');
    }else{
	 $('#clear').css('display', 'block');
	}
    }, interval);
   </script>
