<body id='body' data-target=".navbar" data-offset="50">
    <script>
        var just_change_language = false;

        $(function () {
            $("#Characteristicstabs").tabs({
                activate: function () {
                    var active = $('#Characteristicstabs').tabs('option', 'active');
                    var selectedCharacteristics = $("#Characteristicstabs ul>li a").eq(active).attr("id").replace("Characteristicstabbox", "");
                    document.getElementById("defatltCharacteristics").value = selectedCharacteristics;
                    document.getElementById('dp-select-Characteristics').value = selectedCharacteristics;
                    selectTables(false);
                    changeselectedtabsid("Characteristicstabs");
                    ShowTableContents();
                },
                active: 1
            });
        });

		function getDP(no){
			var val='';
			if (no == 1) {
				return 'District Council Districts';
			} else if (no == 2) {
				return 'District Council Constituency Areas';
			} else if (no == 3) {
				return 'Tertiary Planning Units';
			} else if (no == 4) {
				return 'Subunits';
			} else if (no == 5) {
				return 'New Towns';
			} else {
				return 'Major Housing Estates';
			}
		}
		function getCB(no){
			var val='';
			if (no == 1) {
				return 'Demographic Characteristics';
			} else if (no == 2) {
				return 'Educational Characteristics';
			} else if (no == 3) {
				return 'Economic Characteristics';
			} else if (no == 4) {
				return 'Household Characteristics';
			} else if (no == 5) {
				return 'Housing Characteristics';
			} else {
				return 'Internal Migration Characteristics';
			}
		}

		function gtag() {
			dataLayer.push(arguments);
		}

		function div_click(e){
			//console.log('div click');
			//alert('div click');
			//alert(id);
			var selfName = e.name;
			var event_category = '';
			//var selfName = id;
			//console.log(selfName);
			//alert(selfName);
			var mainv = document.getElementById('CurrentDPMain');
			var prev = document.getElementById('PrevDPMain');

			if ( mainv.value != prev.value ){
				//document.getElementById("CurrentDPSub").setAttribute('value','Demographic Characteristics');
				document.getElementById("CurrentDPSub").value = getCB(1);
				document.getElementById("PrevDPMain").setAttribute('value',selfName);
			}
			if ( mainv == 'Street Blocks'){
				//document.getElementById("CurrentDPSub").setAttribute('value','Internal Migration Characteristics');
			}
			
			try{
			    var tabName = e.href.split("#")[1];
			    console.log("tabName",tabName);
			    //$(".mt-4").hide();
    			if(tabName === "DCCA-tab"){
    			    $(".mt-4").hide();
    			}else if(tabName === "ESTATE-tab"){
    			    $(".mt-4").hide();
    			}else if(tabName === "LTPUG-tab"){
    			    $(".mt-4").show();
                }else if(tabName === "SB-tab") {
                    $(".mt-4").hide();
                    //$(".download_sections").hide();
    			}else if(tabName === "NT-tab"){
    			    $(".mt-4").hide();
    			}else if(tabName === "DC18-tab"){
    			    $(".mt-4").show();
    			}
			}catch(err){
			    console.log(err);
			}

			document.getElementById("CurrentDPMain").setAttribute('value',selfName);
			var subv = document.getElementById('CurrentDPSub');

			event_category = selfName + ' / ' + subv.value;
			//console.log(event_category);

			gtag('event','play', {
			'send_to': 'UA-158804008-1',
			'event_category':''+event_category+'',
			'event_action':'click',
			'event_label':'click',
			'event_value':'1'
			});
		}

		function sub_click(e){
			//console.log('sub_click');
			//alert('sub_click');
			//alert(id);
			var selfName = e.name;
			//var selfName = id;
			//console.log(selfName);
			//alert(selfName);
			document.getElementById("CurrentDPSub").setAttribute('value',selfName);
			var mainv = document.getElementById('CurrentDPMain');
			event_category = mainv.value + ' / ' + selfName;
			console.log(event_category);

			gtag('event','play', {
			'send_to': 'UA-158804008-1',
			'event_category':''+event_category+'',
			'event_action':'click',
			'event_label':'click',
			'event_value':'1'
			});
		}
    </script>

