                        <script>
                            $(function () {
				                        $('button.dropdown-text').val(false);
	                              $('button.dropdown-note').val(false);
                                $("#DPtabs").tabs({
                                    activate: function () {
                                        DeleteAllText();
                                        var active = $('#DPtabs').tabs('option', 'active');
                                        var val;

                                        showAll();

										document.getElementById("CurrentDPSub").value=getCB(1);
                                        if (active == 0) {
                                            val = "DCD";
                                        } else if (active == 1) {
                                            val = "DCCA";
                                        } else if (active == 2) {
                                            val = "TPU";
                                        } else if (active == 3) {
                                            val = "SB";
                                        } else if (active == 4) {
                                            val = "NT";
                                        } else if (active == 5) {
                                            val = "MHE";
                                            $("li:has(#Characteristicstabbox6),#MobileCharacteristicstabbox6").removeClass('showMe').addClass('hideMe');
                                        } else if (active == 6) {
                                            val = "IM";
                                        }

                                        $("#dp-category-0").val(val);

                                        var id = $("#DPtabs div>div div input").eq(active).attr("id");

                                        //changeselectedtabsid("DPtabs");
                                        $("#DPtabs li").removeClass("tab_selected").addClass("tab");
                                        $("#DPtabs .ui-tabs-active").removeClass("tab").addClass("tab_selected");
                                        $('#Characteristicstabs').tabs('option', 'active', 0);

										var charActive = $('#Characteristicstabs').tabs('option', 'active');

										var selectedCharacteristics = $("#Characteristicstabs ul>li a").eq(active).attr("id").replace("Characteristicstabbox", "");
										//var val = $("#dp-category-0").val();

										//console.log('**DPtabs change');

										/*console.log(active);
										console.log(selectedCharacteristics);
										console.log(charActive);*/

                                        document.getElementById("defaultSelectedMap").value = id.replace('dp_resetMapButton-', '');

                                        resetMap(val + 1);
                                    }
                                });
                            });

                            function onDPcategory0change() {
                                
                                showAll();

                                var val = $("#dp-category-0").val();
                                var active;

                                if (val == "DCD") {
                                    active = 0;
                                } else if (val == "DCCA") {
                                    active = 1;
                                } else if (val == "TPU") {
                                    active = 2;
                                } else if (val == "SB") {
                                    active = 3;
                                } else if (val == "NT") {
                                    active = 4;
                                }else if (val == 'MHE') {
                                    active = 5;
                                    $("li:has(#Characteristicstabbox6),#MobileCharacteristicstabbox6").removeClass('showMe').addClass('hideMe');
                                } else if (val == "IM") {
                                    active = 6;
                                }

                                $('#DPtabs').tabs('option', 'active', active);
								//console.log('**onDPcategory0change');

                            }
                        </script>

